# -----------------------------------------
# Kanonische Domain: ohne www (optional)
# -----------------------------------------
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.ugursay-puercek\.com$ [NC]
RewriteRule ^(.*)$ https://ugursay-puercek.com/$1 [L,R=301]

# -----------------------------------------
# Basis-Optionen
# -----------------------------------------
Options -MultiViews
DirectoryIndex index.html
RewriteBase /

# -----------------------------------------
# MIME-Types explizit setzen (WICHTIG!)
# -----------------------------------------
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# -----------------------------------------
# Content-Type Header für JS/CSS forcieren (VOR den Rewrites!)
# -----------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js)$">
    Header set Content-Type "application/javascript"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "\.(css)$">
    Header set Content-Type "text/css"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "\.(ttf|otf|eot|woff|woff2|svg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# -----------------------------------------
# Favicon-Fallback (vermeidet 404/500)
# -----------------------------------------
RewriteCond %{REQUEST_URI} ^/favicon\.ico$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^favicon\.ico$ /assets/favicon.ico [L]

# -----------------------------------------
# SPA-Rewrite:
# WICHTIG: Asset-Dateien ZUERST prüfen!
# -----------------------------------------

# Backend-Endpoints nicht umschreiben
RewriteCond %{REQUEST_URI} ^/sendMail\.php$ [NC]
RewriteRule ^ - [L]

# JS-Dateien EXPLIZIT nicht umschreiben (höchste Priorität!)
RewriteCond %{REQUEST_URI} ^.*\.js$ [NC]
RewriteRule ^ - [L]

# Weitere Asset-Dateien nicht umschreiben
RewriteCond %{REQUEST_URI} \.(css|json|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|otf|eot|ico|map)$ [NC]
RewriteRule ^ - [L]

# Echte Dateien und Ordner nicht umschreiben
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alles andere an Angular übergeben
RewriteRule . /index.html [L]

# -----------------------------------------
# Caching
# -----------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# -----------------------------------------
# (Optional) Komprimierung
# -----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>